# syntax=docker/dockerfile:1.6
# ---------------------------------------------------------------------------
# hal-nemoFinder — production image
#
# Multi-stage, non-root, hardened build.  Designed to run with
# readOnlyRootFilesystem=true in Kubernetes (PodSecurity "restricted").
# ---------------------------------------------------------------------------

ARG PYTHON_VERSION=3.11
ARG APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Stage 1 — builder
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libpq-dev \
        python3-dev \
        make \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Install dependencies into an isolated prefix so the final stage
# can copy a minimal tree.
COPY pyproject.toml README.md ./
COPY src/ src/
COPY alembic/ alembic/
COPY alembic.ini ./

RUN pip install --no-cache-dir --prefix=/install .

# Precompile bytecode for faster cold-start.  Failures are ignored so
# that optional C-extension stubs don't block the build.
RUN python -m compileall -q /install/lib /build/src || true

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS runtime

ARG APP_VERSION
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="hal-nemofinder" \
      org.opencontainers.image.description="Hallucination detection framework for AI-driven drug discovery" \
      org.opencontainers.image.source="https://github.com/hal-nemofinder/hal-nemofinder" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="hal-nemoFinder contributors" \
      org.opencontainers.image.documentation="https://github.com/hal-nemofinder/hal-nemofinder/tree/main/docs"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    PORT=8000 \
    HAL_VERSION=${APP_VERSION}

# Minimal runtime dependencies (libpq for psycopg2, curl for health probe,
# tini for proper PID-1 signal handling).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libpq5 \
        tini \
        curl \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# Non-root user with fixed UID/GID for predictable K8s securityContext.
RUN groupadd --system --gid 10001 hal \
 && useradd  --system --uid 10001 --gid 10001 --home /app --shell /sbin/nologin hal

WORKDIR /app

# Copy installed Python packages from the builder.
COPY --from=builder /install /usr/local

# Copy only the files required at runtime.
COPY --chown=hal:hal src/         /app/src/
COPY --chown=hal:hal alembic/     /app/alembic/
COPY --chown=hal:hal alembic.ini  /app/alembic.ini
COPY --chown=hal:hal pyproject.toml /app/pyproject.toml

# Writable tmpfs locations required when readOnlyRootFilesystem=true;
# these directories will be overlaid by emptyDir volumes in K8s but we
# create them so the image is usable without a volume too.
RUN mkdir -p /app/tmp /app/run /home/hal \
 && chown -R hal:hal /app /home/hal

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/health/live || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "hal-nemofinder"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
